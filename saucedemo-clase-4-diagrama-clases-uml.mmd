classDiagram
    direction TB

    class SauceDemoClase4Test {
        +compraCompleta()
    }

    class PlaywrightPage {
        <<fixture compartido>>
    }

    class LoginPage {
        -page: PlaywrightPage
        +login(usuario, contrasena)
    }

    class InventoryPage {
        -page: PlaywrightPage
        +agregarProducto(id)
        +abrirCarrito()
    }

    class ProductDetailsPage {
        <<nueva>>
        -page: PlaywrightPage
        +agregarAlCarrito()
        +volverAlInventario()
    }

    class CartPage {
        -page: PlaywrightPage
        +iniciarCheckout()
    }

    class CheckoutInformationPage {
        -page: PlaywrightPage
        +completarDatosCliente()
        +continuar()
    }

    class CheckoutOverviewPage {
        -page: PlaywrightPage
        +finalizarCompra()
    }

    class CheckoutCompletePage {
        -page: PlaywrightPage
        +validarConfirmacion()
    }


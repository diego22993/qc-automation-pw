classDiagram
    direction TB

    class Exercise22PriceSort {
        <<test case>>
        +run(page: Page) Promise~void~
        +selectPriceLowToHigh()
        +expectSortValue_lohi()
    }

    class Exercise23NameSort {
        <<test case>>
        +run(page: Page) Promise~void~
        +selectNameZToA()
        +expectSortValue_za()
    }

    class Exercise24FilterOnesie {
        <<test case>>
        +run(page: Page) Promise~void~
        +findSauceLabsOnesieCard()
        +expectOneMatchingCard()
    }

    class Exercise25AddBikeLight {
        <<test case>>
        +run(page: Page) Promise~void~
        +addBikeLightFromCard()
        +expectCartBadge_1()
    }

    class SauceDemoTestHelpers {
        <<test helper>>
        +loginToInventory(page: Page) Promise~InventoryPage~
    }

    class LoginPage {
        <<Page Object>>
        -page: Page
        -usernameInput: Locator
        -passwordInput: Locator
        -loginButton: Locator
        +goto() Promise~void~
        +login(username: string, password: string) Promise~void~
        +expectInventoryPage() Promise~void~
    }

    class InventoryPage {
        <<Page Object>>
        +page: Page
        +inventoryItems: Locator
        +cartLink: Locator
        +cartBadge: Locator
        +sortBy(label: string, expectedValue: string) Promise~void~
        +expectOnlyProduct(productName: string) Promise~void~
        +addProductToCart(productName: string) Promise~void~
        +expectCartCount(count: number) Promise~void~
    }

    class SortOption {
        <<enumeration>>
        PriceLowToHigh = "Price (low to high)"
        NameZToA = "Name (Z to A)"
        PriceLowToHighValue = "lohi"
        NameZToAValue = "za"
    }

    class Page {
        <<Playwright API>>
        +getByRole(role, options) Locator
        +locator(selector) Locator
    }

    class Locator {
        <<Playwright API>>
        +selectOption(label) Promise~void~
        +filter(options) Locator
        +getByRole(role, options) Locator
        +click() Promise~void~
        +toHaveValue(value) Assertion
        +toHaveText(value) Assertion
    }

    Exercise22PriceSort ..> SauceDemoTestHelpers : prepara sesion
    Exercise23NameSort ..> SauceDemoTestHelpers : prepara sesion
    Exercise24FilterOnesie ..> SauceDemoTestHelpers : prepara sesion
    Exercise25AddBikeLight ..> SauceDemoTestHelpers : prepara sesion

    SauceDemoTestHelpers ..> LoginPage : crea y autentica
    SauceDemoTestHelpers ..> InventoryPage : retorna tras login

    Exercise22PriceSort ..> InventoryPage : sortBy(PriceLowToHigh, lohi)
    Exercise23NameSort ..> InventoryPage : sortBy(NameZToA, za)
    Exercise24FilterOnesie ..> InventoryPage : expectOnlyProduct(Onesie)
    Exercise25AddBikeLight ..> InventoryPage : addProductToCart(BikeLight)
    Exercise25AddBikeLight ..> InventoryPage : expectCartCount(1)

    InventoryPage ..> SortOption : opciones de orden
    LoginPage --> Page : automatiza
    InventoryPage --> Page : automatiza
    Page o-- Locator : crea locators
classDiagram
    direction TB

    class SauceDemoTests {
        <<test module>>
        +loginToInventory(page) InventoryPage
        +openCheckoutInformation(page) CheckoutInformationPage
        +openCheckoutOverview(page) CheckoutOverviewPage
        +completeCheckout(page) CheckoutCompletePage
        +Ejercicios_1_a_40()
        +checkout_y_generar_PDF()
        +login_desde_CSV()
    }

    class LoginPage {
        <<Page Object>>
        +page: Page
        +usernameInput: Locator
        +passwordInput: Locator
        +loginButton: Locator
        +errorMessage: Locator
        +goto() Promise~void~
        +login(username, password) Promise~void~
        +expectLoginError(message) Promise~void~
        +expectInventoryPage() Promise~void~
    }

    class InventoryPage {
        <<Page Object>>
        +page: Page
        +inventoryItems: Locator
        +cartLink: Locator
        +cartBadge: Locator
        +expectLoaded() Promise~void~
        +addProductToCart(productName) Promise~void~
        +removeProductFromCart(productName) Promise~void~
        +sortBy(label, expectedValue) Promise~void~
        +expectOnlyProduct(productName) Promise~void~
        +expectInventoryPriceCount(count) Promise~void~
        +expectProductPrice(productName, price) Promise~void~
        +expectCartCount(count) Promise~void~
        +expectCartCountFromContainer(count) Promise~void~
        +openCart() Promise~void~
    }

    class CartPage {
        <<Page Object>>
        -page: Page
        -cartItems: Locator
        -checkoutButton: Locator
        +expectLoaded() Promise~void~
        +expectProduct(productName) Promise~void~
        +removeProduct(productName) Promise~void~
        +removeAllProducts() Promise~void~
        +expectItemCount(count) Promise~void~
        +checkout() Promise~void~
    }

    class CheckoutInformationPage {
        <<Page Object>>
        -page: Page
        +expectLoaded() Promise~void~
        +continueWithCustomer(firstName, lastName, postalCode) Promise~void~
    }

    class CheckoutOverviewPage {
        <<Page Object>>
        -page: Page
        -cartItems: Locator
        +expectLoaded() Promise~void~
        +expectProduct(productName) Promise~void~
        +expectSubtotalPrefix(prefix) Promise~void~
        +expectTaxVisible() Promise~void~
        +expectTotalVisible() Promise~void~
        +finish() Promise~void~
    }

    class CheckoutCompletePage {
        <<Page Object>>
        -page: Page
        +expectLoaded() Promise~void~
        +expectDispatchedMessage() Promise~void~
        +goBackHome() Promise~void~
        +generatePdf() Promise~Download~
    }

    class UserDataProvider {
        <<module>>
        +loadSauceDemoUsers() SauceDemoUser[]
    }

    class SauceDemoUser {
        <<interface>>
        +username: string
        +password: string
        +expectedOutcome: LoginOutcome
    }

    class LoginOutcome {
        <<type>>
        success
        locked_out
    }

    class UsersCSV {
        <<data file>>
        +username
        +password
        +expectedOutcome
    }

    class PlaywrightPage {
        <<external API>>
        +locator(selector) Locator
        +getByRole(role, options) Locator
        +goto(url) Promise~Response~
        +waitForEvent(download) Promise~Download~
    }

    SauceDemoTests ..> LoginPage : crea y usa
    SauceDemoTests ..> InventoryPage : crea y usa
    SauceDemoTests ..> CartPage : crea y usa
    SauceDemoTests ..> CheckoutInformationPage : crea y usa
    SauceDemoTests ..> CheckoutOverviewPage : crea y usa
    SauceDemoTests ..> CheckoutCompletePage : crea y usa
    SauceDemoTests ..> UserDataProvider : carga credenciales

    UsersCSV ..> UserDataProvider : parseado por
    UserDataProvider ..> SauceDemoUser : retorna filas tipadas
    SauceDemoUser --> LoginOutcome : expectedOutcome

    LoginPage ..> PlaywrightPage : automatiza
    InventoryPage ..> PlaywrightPage : automatiza
    CartPage ..> PlaywrightPage : automatiza
    CheckoutInformationPage ..> PlaywrightPage : automatiza
    CheckoutOverviewPage ..> PlaywrightPage : automatiza
    CheckoutCompletePage ..> PlaywrightPage : automatiza

    LoginPage ..> InventoryPage : login exitoso
    InventoryPage ..> CartPage : abre carrito
    CartPage ..> CheckoutInformationPage : Checkout
    CheckoutInformationPage ..> CheckoutOverviewPage : Continue
    CheckoutOverviewPage ..> CheckoutCompletePage : Finish
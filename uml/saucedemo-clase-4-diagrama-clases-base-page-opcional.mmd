classDiagram
    direction TB

    class SauceDemoClase4Test {
        +compraCompleta()
    }

    class PlaywrightPage {
        <<fixture compartido>>
    }

    class BasePage {
        <<abstract>>
        <<opcional: extraer si hay comportamiento comun>>
        #page: PlaywrightPage
        +constructor(page)
    }

    class LoginPage {
        +login(usuario, contrasena)
    }

    class InventoryPage {
        +agregarProducto(id)
        +abrirCarrito()
    }

    class ProductDetailsPage {
        <<nueva>>
        +agregarAlCarrito()
        +volverAlInventario()
    }

    class CartPage {
        +iniciarCheckout()
    }

    class CheckoutInformationPage {
        +completarDatosCliente()
        +continuar()
    }

    class CheckoutOverviewPage {
        +finalizarCompra()
    }

    class CheckoutCompletePage {
        +validarConfirmacion()
    }

    SauceDemoClase4Test ..> LoginPage : utiliza
    SauceDemoClase4Test ..> InventoryPage : utiliza
    SauceDemoClase4Test ..> ProductDetailsPage : utiliza
    SauceDemoClase4Test ..> CartPage : utiliza
    SauceDemoClase4Test ..> CheckoutInformationPage : utiliza
    SauceDemoClase4Test ..> CheckoutOverviewPage : utiliza
    SauceDemoClase4Test ..> CheckoutCompletePage : utiliza

    LoginPage --|> BasePage
    InventoryPage --|> BasePage
    ProductDetailsPage --|> BasePage
    CartPage --|> BasePage
    CheckoutInformationPage --|> BasePage
    CheckoutOverviewPage --|> BasePage
    CheckoutCompletePage --|> BasePage

    BasePage --> PlaywrightPage : conserva referencia

    note for BasePage "Recomendacion: agregar solo logica identica y repetida entre paginas. No incluir acciones de negocio ni selectores especificos. Si solo comparte el campo Page, comenzar sin herencia y reevaluar despues."

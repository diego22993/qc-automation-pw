{
  "name": "qc-automation-pw",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test --ui --grep @smoke",
    "test:booking": "npx playwright test --grep @booking",
    "debug:booking": "npx playwright test --debug --grep @booking",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "test:dev": "npx cross-env TEST_ENV=dev npx playwright test",
    "test:qa": "npx cross-env TEST_ENV=qa npx playwright test",
    "test:dev:report": "npm run test:dev && npx playwright show-report",
    "test:qa:report": "npm run test:qa && npx playwright show-report",
    "report": "npx playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diego22993/qc-automation-pw.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/diego22993/qc-automation-pw/issues"
  },
  "homepage": "https://github.com/diego22993/qc-automation-pw#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}

{
  "name": "qc-automation-pw",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:login": "npx playwright test --ui --grep @login", 
    "test:inventario": "npx playwright test --ui --grep @inventario",
    "test:carro": "npx playwright test --ui --grep @carro",
    "test:checkout": "npx playwright test --ui --grep @checkout1",
    "test:checkout2": "npx playwright test --ui --grep @checkout2",
    "test:login-inv": "npx playwright test --ui --grep @login-inv",
    "test:cart-nav": "npx playwright test --ui --grep @cart-nav",
    "test:formCheckout1": "npx playwright test --ui --grep @formCheckout1",
    "test:formCheckout2": "npx playwright test --ui --grep @formCheckout2",
    "test:menuLateral": "npx playwright test --ui --grep @menuLateral",
    "test:collecciones": "npx playwright test --ui --grep @collecciones",
    "test:e2e": "npx playwright test --ui --grep @e2e",
    "test:flujoCompleto": "npx playwright test --ui --grep @flujoCompleto",
    "test:report": "npx playwright show-report",
    "testReport": "npx playwright test && npx playwright show-report",
    "test:smoke": "npx playwright test --ui --grep @smoke",
    "test:booking": "npx playwright test --ui --grep @booking",
    "debug:booking": "npx playwright test --debug --grep @booking",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diego22993/qc-automation-pw.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/diego22993/qc-automation-pw/issues"
  },
  "homepage": "https://github.com/diego22993/qc-automation-pw#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0"
  }
}
